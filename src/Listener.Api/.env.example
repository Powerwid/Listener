# Copia este archivo como .env y reemplaza los valores para tu entorno local.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__ListenerDb=Server=localhost;Database=TonysGoListenerLocal;Trusted_Connection=True;TrustServerCertificate=True
ListenerSecurity__CollectorApiKey=CLAVE-LOCAL-COLECTOR-DE-32-O-MAS-CARACTERES
# CollectorApiKey solo corresponde al flujo Yape anterior. BBVA se vincula por QR.
DevicePairing__PublicBaseUrl=
# Opcional: hash de ASP.NET Identity para instalaciones que usan secretos del hosting.
ListenerAdmin__Username=admin
ListenerAdmin__PasswordHash=
ListenerSecurity__TonysGoApiKey=CLAVE-LOCAL-TONYSGO-DE-32-O-MAS-CARACTERES
Yape__CuentaReceptora=TONYSGO-YAPE-LOCAL
TonysGo__CallbackUrl=
# Receptor de abonos BBVA en AppTaxi.Api (se implementa por separado).
TonysGo__AbonosUrl=
TonysGo__CallbackApiKey=CLAVE-LOCAL-CALLBACK-DE-32-O-MAS-CARACTERES
