@page "/panel"
@model Listener.Api.Pages.PanelModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Listener · Panel de correo</title>
    <link rel="stylesheet" href="~/panel/panel.css" asp-append-version="true" />
    <script src="~/panel/panel.js" asp-append-version="true" defer></script>
</head>
<body>
<div class="app">
    <aside class="sidebar">
        <a class="brand" href="/panel"><span class="brand-icon">L</span> Listener<span class="brand-dot">.</span></a>
        <p class="sidebar-label">TONYSGO / ADMINISTRACIÓN</p>
        <a class="nav-item active" href="/panel"><span>▣</span> Lector automático</a>
        <a class="nav-item" href="/panel?view=resultados"><span>≡</span> Resultados</a>
        <div class="sidebar-bottom"><span class="local-dot"></span> Entorno local<p>Acceso desde este equipo.<br />Recepción automática de avisos.</p></div>
    </aside>
    <main>
        <header><div class="breadcrumb">Administración <span>/</span> Correo</div><span class="environment">DESARROLLO</span></header>
        <section class="intro"><div><p class="eyebrow">CENTRO DE LECTURA</p><h1>Conexión y lectura de correo.</h1><p>Activa el lector una vez y recibe resultados de los nuevos avisos BCP automáticamente.</p></div><span class="mode-label">● Solo lectura</span></section>
        <section class="card automatic-status"><div><h2>Lector automático</h2><p id="automatic-status" role="status">@Model.AutomaticStatus.Estado</p><p id="automatic-detail" class="field-help">Consulta cada 30 segundos · @Model.AutomaticStatus.Guardados correos guardados en esta sesión.</p><p id="automatic-error" role="alert">@Model.AutomaticStatus.Error</p></div><div class="button-row"><a class="button secondary" href="/panel">Actualizar historial</a><form method="post" asp-page-handler="Stop"><button class="button secondary" type="submit">Detener lector</button></form></div></section>
        @if (Model.Failure is not null) { <div class="notice error" role="alert">@Model.Failure</div> }
        @if (Model.Notice is not null) { <div class="notice success" role="status">@Model.Notice</div> }
        <div class="actions-grid">
            <section class="card">
                <div class="card-heading"><span class="step">01</span><div><h2>Conectar Gmail</h2><p>Una conexión para recibir los nuevos avisos BCP.</p></div></div>
                <form method="post" asp-page-handler="Gmail" class="work-form">
                    <label asp-for="Email">Correo de Google</label>
                    <input asp-for="Email" type="email" required autocomplete="username" />
                    <label for="AppPassword">Contraseña de aplicación</label>
                    <input id="AppPassword" name="AppPassword" type="password" maxlength="128" required autocomplete="off" placeholder="16 caracteres de Google" />
                    <p class="field-help">Al activar, la contraseña permanece en memoria hasta detener el lector o reiniciar el servidor. No se guarda en disco.</p>
                    <div class="form-row"><div><label asp-for="Days">Últimos días</label><input asp-for="Days" type="number" min="1" max="90" required /></div><div><label asp-for="Limit">Máximo de correos</label><input asp-for="Limit" type="number" min="1" max="100" required /></div></div>
                    <p class="field-help">Días y máximo aplican solo a la consulta manual. El lector automático comienza con correos nuevos; al reconectar retoma el último procesado.</p>
                    <div class="button-row"><button class="button primary" type="submit" name="activate" value="true">Activar lector →</button><button class="button secondary" type="submit" name="testOnly" value="true">Probar conexión</button></div>
                    <details class="manual-tools"><summary>Herramienta de diagnóstico</summary><button class="button secondary" type="submit">Consultar correos anteriores</button></details>
                    <p class="working" role="status" hidden>Conectando y procesando… Puede tardar hasta 45 segundos.</p>
                </form>
            </section>
            <section class="card upload-card">
                <div class="card-heading"><span class="step">02</span><div><h2>Diagnóstico opcional</h2><p>Los archivos sirven para probar plantillas; no son el flujo de recepción.</p></div></div>
                <form method="post" asp-page-handler="Files" enctype="multipart/form-data" class="work-form">
                    <div class="file-area"><span class="file-icon">↥</span><label for="Files">Selecciona tus correos .eml</label><p>Hasta 20 archivos · 1 MiB por archivo</p><input id="Files" name="Files" type="file" accept=".eml,message/rfc822" multiple required /></div>
                    <button class="button secondary wide" type="submit">Analizar archivos</button>
                    <p class="working" role="status" hidden>Analizando los archivos…</p>
                </form>
                <p class="upload-note">Compatible con yapeos recibidos y consumos BCP. Las transferencias aún requieren una plantilla de ejemplo.</p>
            </section>
        </div>
        <section id="android-live-debug" class="card debug-console" hidden>
            <div class="section-heading"><div><h2>Depuración en vivo de Yape</h2><p>Intentos de consulta y nuevas notificaciones detectadas por esta página.</p></div><span id="android-debug-state" class="mode-label">Iniciando…</span></div>
            <pre id="android-debug-log" aria-live="polite">Esperando la primera consulta…</pre>
        </section>
        <section id="results" class="results-section">
            <section class="android-results">
                <div class="section-heading"><div><h2>Yapes recibidos desde Android</h2><p>Notificaciones capturadas por el teléfono y almacenadas en ListenerDb. Recibir una notificación no autoriza una recarga.</p></div><span class="mode-label">@Model.AndroidYapeNotifications.Count registros</span></div>
                @if (Model.AndroidYapeNotifications.Count == 0)
                {
                    <div class="empty"><span>⌕</span><h3>Aún no hay notificaciones Android</h3><p>Comprueba el permiso de notificaciones, la conexión ADB y el estado HTTP 200 en el teléfono.</p></div>
                }
                else
                {
                    <div class="table-wrap"><table><thead><tr><th>Estado</th><th>Notificación</th><th>Importe</th><th>Fecha (Perú)</th><th>Detalle</th></tr></thead><tbody>
                    @foreach (var item in Model.AndroidYapeNotifications)
                    {
                        var processed = item.Estado == "Procesado";
                        var ready = processed && item.CodigoMotivo == "NOTIFICACION_LISTA_PARA_COMPARAR";
                        var label = !processed ? "Descartada" : ready ? "Datos extraídos" : "Por revisar";
                        <tr data-yape-notification-id="@item.Id"><td><span class="badge @(ready ? "income" : processed ? "" : "bad")">@label</span></td><td><strong>@(item.Titulo ?? "Notificación Yape")</strong><small>@(item.Pagador ?? "Pagador no extraído")</small></td><td class="money">@(item.Monto is decimal amount ? $"PEN {amount.ToString("N2", CultureInfo.GetCultureInfo("es-PE"))}" : "—")</td><td>@item.FechaNotificacion.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")</td><td><details><summary>Ver datos</summary><dl><dt>Motivo</dt><dd>@(item.CodigoMotivo ?? "Sin motivo")</dd><dt>Código</dt><dd>@(item.CodigoSeguridad ?? "No presente en la notificación")</dd><dt>Texto recibido</dt><dd>@(item.Texto ?? "No disponible")</dd><dt>Detalle recibido</dt><dd>@(item.Detalle ?? "No disponible")</dd><dt>Extractor</dt><dd>@item.VersionExtractor</dd><dt>Registrado</dt><dd>@item.FechaRegistro.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm:ss")</dd></dl></details></td></tr>
                    }
                    </tbody></table></div>
                }
            </section>
            <div class="results-divider"></div>
            <div class="section-heading"><div><h2>Resultado de la lectura</h2><p>Extraer los datos de un ingreso no autoriza una recarga.</p></div>@if (Model.Report is not null) { <form method="post" asp-page-handler="Download"><textarea name="reportJson" hidden>@Model.ReportJson</textarea><button id="download-json" type="submit" class="button secondary">Descargar JSON ↓</button></form> }</div>
            <div class="metrics">
                <div class="metric"><span>Ingresos extraídos</span><strong>@(Model.Report?.IngresosExtraidos.Count.ToString() ?? "—")</strong><small>Yapeos con datos consistentes</small></div>
                <div class="metric"><span>Descartados</span><strong>@(Model.Report?.Descartados.Count.ToString() ?? "—")</strong><small>Consumos y otros egresos</small></div>
                <div class="metric"><span>Por revisar</span><strong>@(Model.Report?.Revision.Count.ToString() ?? "—")</strong><small>Formatos o datos pendientes</small></div>
                <div class="metric"><span>Errores</span><strong>@(Model.Report?.Errores.Count.ToString() ?? "—")</strong><small>Mensajes no procesados</small></div>
            </div>
            @if (Model.Report is null)
            {
                <div class="empty"><span>⌕</span><h3>Tu primera lectura empieza arriba</h3><p>Consulta Gmail o selecciona un .eml.<br />Aquí aparecerán los importes, las fechas y el detalle de cada mensaje.</p></div>
            }
            else
            {
                <div class="report-meta"><span>Origen: <strong>@(Model.Report.Origen == "GmailImap" ? "Gmail · INBOX" : Model.Report.Origen == "BaseDeDatos" ? "Historial automático · SQL Server" : "Archivos locales")</strong> · Encontrados: @Model.Report.CoincidenciasFiltro · Límite: @Model.Report.Limite</span><span>@(Model.Report.Persistido ? "Guardado en ListenerDb" : "Sin persistencia") · Pagos sin verificar</span></div>
                <div class="filters"><label for="result-filter">Mostrar</label><select id="result-filter"><option value="">Todos</option><option>Ingreso extraído</option><option>Descartado</option><option>Revisión</option><option>Error</option></select><label for="result-search" class="sr-only">Buscar en resultados</label><input id="result-search" type="search" placeholder="Buscar nombre, asunto o referencia…" /></div>
                <div class="table-wrap"><table><thead><tr><th>Clasificación</th><th>Operación / correo</th><th>Importe</th><th>Fecha (Perú)</th><th>Detalle</th></tr></thead><tbody>
                @foreach (var row in Model.Rows)
                {
                    var data = row.Item.Datos;
                    <tr data-group="@row.Group"><td><span class="badge @(row.Group == "Ingreso extraído" ? "income" : row.Group == "Error" ? "bad" : "")">@row.Group</span></td><td><strong>@(data?.TipoOperacion ?? "Error de lectura")</strong><small>@(data?.Ordenante ?? data?.Empresa ?? data?.Asunto ?? row.Item.Referencia)</small></td><td class="money">@(data?.Monto is decimal amount ? $"{data.Moneda} {amount.ToString("N2", CultureInfo.GetCultureInfo("es-PE"))}" : "—")</td><td>@(data?.FechaOperacion?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td><td><details><summary>Ver datos</summary><dl><dt>Referencia</dt><dd>@row.Item.Referencia</dd><dt>Asunto</dt><dd>@data?.Asunto</dd><dt>Remitente</dt><dd>@data?.Remitente</dd><dt>N.º de operación</dt><dd>@(data?.NumeroOperacion ?? "No disponible")</dd><dt>Estado</dt><dd>@data?.Estado</dd><dt>Motivo</dt><dd>@(row.Item.Error ?? data?.Motivo)</dd><dt>Autenticidad</dt><dd>@(data?.AutenticidadCorreo ?? "No comprobada")</dd></dl></details></td></tr>
                }
                </tbody></table></div>
                <p id="no-matches" class="field-help" hidden>No hay resultados para este filtro.</p>
                <details class="json-details"><summary>Ver respuesta JSON</summary><pre id="report-json">@Model.ReportJson</pre></details>
            }
        </section>
        <footer>Listener para TonysGo <span>El lector activo funciona con el servidor encendido, incluso al cerrar el navegador.</span></footer>
    </main>
</div>
</body>
</html>
